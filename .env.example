# Vorlage für eigene Deployments. Als .env.local kopieren oder die Werte beim
# Hoster (Vercel, Netlify, eigener Build-Server) als Umgebungsvariablen setzen.
# Ohne Angaben verhält sich die Seite wie auf angebunden.ch.

# Adresse, unter der die Seite öffentlich läuft. Steckt in canonical-Links,
# sitemap.xml, robots.txt und den Vorschaubildern für geteilte Links.
NEXT_PUBLIC_SITE_URL=https://angebunden.ch

# GoatCounter-Konto (Subdomain vor .goatcounter.com) für cookielose
# Besucherzahlen. Leer lassen, dann wird ausserhalb von angebunden.ch nicht gezählt.
NEXT_PUBLIC_GOATCOUNTER=

# Nur für den Build: 1 erzeugt mit `pnpm export` einen Ordner out/ aus reinen
# statischen Dateien, der auf jedem Webserver läuft.
# STATISCH=1

# Nur für die Pipeline: welche Stadt gerechnet wird (zuerich, basel, bern).
# STADT=zuerich
