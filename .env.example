# Vorlage für eigene Deployments. Als .env.local kopieren oder die Werte beim
# Hoster (Vercel, Netlify, eigener Build-Server) als Umgebungsvariablen setzen.
# Ohne Angaben verhält sich die Seite wie auf angebunden.ch.

# Adresse, unter der die Seite öffentlich läuft. Steckt in canonical-Links,
# sitemap.xml, robots.txt und den Vorschaubildern für geteilte Links.
NEXT_PUBLIC_SITE_URL=https://angebunden.ch

# GoatCounter-Konto (Subdomain vor .goatcounter.com) für cookielose
# Besucherzahlen. Leer lassen, dann wird ausserhalb von angebunden.ch nicht gezählt.
NEXT_PUBLIC_GOATCOUNTER=

# Konto im Velonavi: Anmeldung, aufgezeichnete Fahrten und was daraus gelernt
# wird. Adresse und öffentlicher Schlüssel eines Supabase-Projekts; beide stehen
# danach im ausgelieferten JavaScript, das ist so vorgesehen. Den geheimen
# Schlüssel (service_role, sb_secret_…) braucht die Seite nicht. Einrichtung:
# docs/betreiben.md. Leer lassen, dann gibt es im Velonavi kein Konto.
# Statt des Publishable Key geht auch NEXT_PUBLIC_SUPABASE_ANON_KEY. Die Namen
# der Vercel-Integration mit Präfix STORAGE (NEXT_PUBLIC_STORAGE_SUPABASE_URL,
# NEXT_PUBLIC_STORAGE_SUPABASE_ANON_KEY) liest die Seite ebenfalls.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Woher /wohnungen die gesammelten Inserate lädt. Ohne Angabe vom Zweig
# «wohnungen» dieses Repositorys, den .github/workflows/wohnungen.yml füllt.
# Die Adresse muss CORS erlauben. Fällt sie aus, nimmt die Seite
# /data/zuerich/wohnungen.json.
NEXT_PUBLIC_WOHNUNGEN_URL=

# Nur für den Build: 1 erzeugt mit `pnpm export` einen Ordner out/ aus reinen
# statischen Dateien, der auf jedem Webserver läuft.
# STATISCH=1

# Nur für die Pipeline: welche Stadt gerechnet wird (zuerich, basel, bern).
# STADT=zuerich
