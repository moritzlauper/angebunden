# Postgres (Neon, Supabase …). Leer lassen: lokal läuft PGlite in ./.data
DATABASE_URL=

# Passwort für die Weboberfläche. Leer = kein Login (nur lokal sinnvoll)
APP_PASSWORD=

# Geheimnis für den MCP-Zugang. Die URL für Claude lautet dann
#   https://<deine-domain>/api/mcp/<MCP_TOKEN>
# Leer = MCP ist abgeschaltet (lokal: http://localhost:3000/api/mcp/dev)
MCP_TOKEN=

# Signiert das Login-Cookie. Beliebige lange Zeichenkette
SESSION_SECRET=

# Beim ersten Start Klinische Biopsychologie mit der bestehenden Aussagenbank anlegen
SEED_ON_EMPTY=1
