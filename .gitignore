# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# aus node_modules kopiert, siehe scripts/copy-maplibre-worker.mjs
/public/maplibre

# per scripts/fetch-glyphs.mjs geholt
/public/fonts

# Rohdaten (GTFS 197 MB, OSM 132 MB) und Zwischenstände – per `pnpm daten` neu erzeugbar
/data/raw
/data/derived

# statischer Export, per `pnpm export` erzeugbar
/out


# KI-Agent-Instruktionen, nur lokal (AGENTS.md schreibt `next dev` neu)
/AGENTS.md
/CLAUDE.md

# Besucherzahlen: die Action schreibt sie auf den Zweig «besucherzahlen», damit
# main nicht täglich einen Bot-Commit bekommt. Lokale Läufe bleiben unsichtbar.
analytics/besucher.json
analytics/besucher.csv
